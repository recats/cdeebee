{
  "name": "@recats/cdeebee",
  "version": "4.0.0",
  "description": "Standalone normalized data store with a typed request pipeline",
  "repository": "git@github.com:recats/cdeebee.git",
  "author": "recats",
  "license": "MIT",
  "scripts": {
    "lint": "eslint lib tests",
    "lint:ts": "tsc --noEmit",
    "lint:all": "pnpm lint && pnpm lint:ts",
    "build": "vite build",
    "prepublishOnly": "pnpm build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "react",
    "store",
    "fetch",
    "data",
    "normalize"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^10.0.3",
    "jsdom": "^28.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^4.1.0"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "packageManager": "pnpm@9.15.1"
}
